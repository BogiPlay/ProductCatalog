<Window x:Class="ProductCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProductCatalog.Controls"
        Title="Каталог на продукти"
        Icon="Assets/app.ico"
        Width="1400" Height="860"
        MinWidth="1260" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Собствена заглавна лента (без стандартната рамка на Windows) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="rootBorder" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- ================= ЗАГЛАВНА ЛЕНТА ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" />

                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6E8BFF" Offset="0" />
                                <GradientStop Color="#B18CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="17"
                                   Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Каталог на продукти" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="SQLite · CRUD · WPF" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnTheme" Style="{StaticResource TitleBarBtn}" Click="BtnTheme_Click"
                            ToolTip="Светла / тъмна тема">
                        <TextBlock x:Name="iconTheme" Style="{StaticResource Icon}" Text="&#xE706;" FontSize="15" />
                    </Button>
                    <Border Width="1" Height="22" Margin="4,0" Background="{DynamicResource LineBrush}" />
                    <Button Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click" ToolTip="Минимизиране">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource TitleBarBtn}" Click="BtnMaximize_Click" ToolTip="Цял екран">
                        <TextBlock x:Name="iconMaximize" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseBtn}" Click="BtnClose_Click" ToolTip="Затваряне">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= СЪДЪРЖАНИЕ ================= -->
            <Grid Grid.Row="1" Margin="20,18,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <!-- ============ Лява част: статистика, филтри, таблица ============ -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Статистически карти -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="-7,0,-7,16">
                        <!-- Брой продукти -->
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="19"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Продукти" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="txtStatCount" Text="0" FontSize="22" FontWeight="Bold" />
                                    <TextBlock x:Name="txtStatCountSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Обща стойност -->
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE825;" FontSize="19"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Стойност на склада" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="txtStatValue" Text="0,00 €" FontSize="22" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="txtStatValueSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Средна цена -->
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource VioletSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8EF;" FontSize="19"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource VioletBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Средна цена" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="txtStatAvg" Text="0,00 €" FontSize="22" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="txtStatAvgSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ниска наличност (кликаема – включва филтъра) -->
                        <Border x:Name="cardLowStock" Style="{StaticResource Card}" Margin="7,0" Cursor="Hand"
                                MouseLeftButtonUp="CardLowStock_MouseLeftButtonUp"
                                ToolTip="Кликнете, за да покажете само продуктите с ниска наличност">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource WarningSoftBrush}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="19"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ниска наличност" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock x:Name="txtStatLow" Text="0" FontSize="22" FontWeight="Bold" />
                                    <TextBlock x:Name="txtStatLowSub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Лента за търсене и филтри (Урок 13) -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <TextBox x:Name="txtSearch"
                                             Tag="Търсене по име, категория, описание или #номер…"
                                             Padding="38,0,36,0"
                                             MaxLength="100"
                                             TextChanged="TxtSearch_TextChanged"
                                             KeyDown="TxtSearch_KeyDown" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="14,0,0,0"
                                               HorizontalAlignment="Left" IsHitTestVisible="False"
                                               Foreground="{DynamicResource MutedBrush}" />
                                    <Button x:Name="btnClearSearch" Style="{StaticResource IconBtn}" Width="28" Height="28"
                                            HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed"
                                            ToolTip="Изчисти търсенето (Esc)" Click="BtnClearSearch_Click">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                                    </Button>
                                </Grid>

                                <Button x:Name="btnSearch" Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="40"
                                        Margin="10,0,0,0" Padding="18,0" Click="BtnSearch_Click" ToolTip="Търсене (Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Търси" />
                                    </StackPanel>
                                </Button>

                                <ComboBox x:Name="cmbFilterCategory" Grid.Column="2" Width="190" Margin="10,0,0,0"
                                          ToolTip="Филтър по категория"
                                          SelectionChanged="Filter_Changed" />

                                <ComboBox x:Name="cmbSort" Grid.Column="3" Width="200" Margin="10,0,0,0"
                                          ToolTip="Подредба (ORDER BY)"
                                          SelectionChanged="Filter_Changed" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="2,0,10,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <controls:NumericBox x:Name="numMinPrice" Grid.Column="1" Width="120" Height="36"
                                                     Placeholder="от" Suffix="€" Decimals="2" ShowButtons="False"
                                                     ValueChanged="PriceFilter_ValueChanged" />
                                <TextBlock Grid.Column="2" Text="—" Margin="8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <controls:NumericBox x:Name="numMaxPrice" Grid.Column="3" Width="120" Height="36"
                                                     Placeholder="до" Suffix="€" Decimals="2" ShowButtons="False"
                                                     ValueChanged="PriceFilter_ValueChanged" />

                                <CheckBox x:Name="chkLowStock" Grid.Column="4" Margin="24,0,0,0" VerticalAlignment="Center"
                                          Style="{StaticResource Switch}"
                                          Content="Само с ниска наличност (под 5 бр.)"
                                          Checked="Filter_Changed" Unchecked="Filter_Changed" />

                                <Button x:Name="btnClearFilters" Grid.Column="6" Style="{StaticResource BtnGhost}" Height="34"
                                        Click="BtnClearFilters_Click" ToolTip="Нулирай всички филтри">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Изчисти филтрите" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Таблица с продукти -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="18,12,10,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Продукти" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Margin="10,0,0,0" CornerRadius="6" Padding="8,2"
                                            Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtResultCount" Text="0 записа" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource BtnGhost}" Height="34" Click="BtnRefresh_Click" ToolTip="Презареди от базата (F5)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Обнови" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnGhost}" Height="34" Margin="4,0,0,0" Click="BtnExport_Click"
                                            ToolTip="Запази показаните продукти като CSV за Excel (Ctrl+E)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Експорт CSV" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="gridProducts" Grid.Row="1" Margin="4,0,4,6"
                                      SelectionChanged="GridProducts_SelectionChanged"
                                      MouseDoubleClick="GridProducts_MouseDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Редактирай" Click="MenuEdit_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Дублирай" InputGestureText="Ctrl+D" Click="MenuDuplicate_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Изтрий" InputGestureText="Del" Click="MenuDelete_Click">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="№" Width="60" SortMemberPath="Id">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id, StringFormat=#{0}}" FontSize="12.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ПРОДУКТ" Width="*" MinWidth="200" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="10"
                                                            Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DescriptionPreview}" FontSize="12" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="КАТЕГОРИЯ" Width="130" SortMemberPath="Category">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="9,3"
                                                        Background="{DynamicResource Surface2Brush}"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Category}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ЦЕНА" Width="130" SortMemberPath="Price"
                                                            HeaderStyle="{StaticResource HeaderRight}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} €}" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding TotalValue, StringFormat=общо {0:N2} €}" FontSize="11.5"
                                                               Margin="0,2,0,0" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="НАЛИЧНОСТ" Width="170" SortMemberPath="Quantity">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0} бр.}" Width="62"
                                                               VerticalAlignment="Center" />
                                                    <Border x:Name="pill" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"
                                                            Background="{DynamicResource SuccessSoftBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="dot" Width="6" Height="6" Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{DynamicResource SuccessBrush}" />
                                                            <TextBlock x:Name="pillText" Text="{Binding StockStatus}" FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SuccessBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                        <Setter TargetName="pill" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        <Setter TargetName="dot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                        <Setter TargetName="pillText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="ПРОМЕНЕН" Width="118" SortMemberPath="UpdatedAt">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UpdatedAt, StringFormat=dd.MM.yyyy}" FontSize="12.5" />
                                                    <TextBlock Text="{Binding UpdatedAt, StringFormat=HH:mm}" FontSize="11.5" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Празно състояние -->
                            <StackPanel x:Name="emptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed" Margin="0,0,0,30">
                                <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource AccentSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock x:Name="emptyIcon" Style="{StaticResource Icon}" Text="&#xE721;" FontSize="26"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <TextBlock x:Name="txtEmptyTitle" Text="Няма намерени продукти" FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                                <TextBlock x:Name="txtEmptyHint" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <Button x:Name="btnEmptyClear" Style="{StaticResource Btn}" HorizontalAlignment="Center"
                                        Margin="0,16,0,0" Click="BtnClearFilters_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock Text="Изчисти филтрите" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Дясна част: редактор (Create / Update / Delete) ============ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заглавие на редактора -->
                        <Border Padding="20,18,20,16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="txtEditorTitle" Text="Нов продукт" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtEditorSubtitle" Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Text="Попълнете полетата и натиснете „Добави продукт“." />
                                </StackPanel>
                                <Border x:Name="pillMode" Grid.Column="1" VerticalAlignment="Top" Margin="12,2,0,0"
                                        CornerRadius="6" Padding="9,3" Background="{DynamicResource SuccessSoftBrush}">
                                    <TextBlock x:Name="txtMode" Text="НОВ" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Полета -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Име на продукта *" />
                                <TextBox x:Name="txtName" Tag="напр. Безжична мишка" MaxLength="100"
                                         TextChanged="TxtName_TextChanged" />
                                <TextBlock x:Name="errName" Style="{StaticResource FieldError}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Категория *" />
                                <ComboBox x:Name="cmbCategory" IsEditable="True" IsTextSearchEnabled="True"
                                          TextBoxBase.TextChanged="CmbCategory_TextChanged"
                                          ToolTip="Изберете от списъка или въведете нова категория" />
                                <TextBlock x:Name="errCategory" Style="{StaticResource FieldError}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Цена *" />
                                        <controls:NumericBox x:Name="numPrice" Decimals="2" Step="1" Suffix="€"
                                                             Placeholder="0,00" Maximum="1000000"
                                                             ValueChanged="NumPrice_ValueChanged" />
                                        <TextBlock x:Name="errPrice" Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Наличност *" />
                                        <controls:NumericBox x:Name="numQuantity" Decimals="0" Step="1" Suffix="бр."
                                                             Placeholder="0" Maximum="1000000"
                                                             ValueChanged="NumQuantity_ValueChanged" />
                                        <TextBlock x:Name="errQuantity" Style="{StaticResource FieldError}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Описание" />
                                    <TextBlock x:Name="txtDescCounter" Text="0 / 500" FontSize="11.5" HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom" Margin="0,0,2,6"
                                               Foreground="{DynamicResource MutedBrush}" />
                                </Grid>
                                <TextBox x:Name="txtDescription" Tag="Кратко описание (по избор)" MaxLength="500"
                                         Height="96" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         TextChanged="TxtDescription_TextChanged" />
                                <TextBlock x:Name="errDescription" Style="{StaticResource FieldError}" />

                                <!-- Информация за избрания запис -->
                                <Border x:Name="metaPanel" Margin="0,18,0,0" Padding="14,12" CornerRadius="10"
                                        Background="{DynamicResource Surface2Brush}" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Създаден" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock x:Name="txtMetaCreated" Grid.Column="1" FontSize="12" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="Последна промяна" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock x:Name="txtMetaUpdated" Grid.Row="1" Grid.Column="1" FontSize="12"
                                                   Margin="0,6,0,0" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="Стойност на наличността" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock x:Name="txtMetaValue" Grid.Row="2" Grid.Column="1" FontSize="12"
                                                   FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Бутони за действия -->
                        <Border Grid.Row="2" Padding="20,14,20,16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Button x:Name="btnAdd" Style="{StaticResource BtnPrimary}" Height="42"
                                        Click="BtnAdd_Click" ToolTip="INSERT – добавя нов запис (Ctrl+S в режим „нов“)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                                        <TextBlock x:Name="txtAddLabel" Text="Добави продукт" />
                                    </StackPanel>
                                </Button>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnUpdate" Style="{StaticResource Btn}" Height="42"
                                            Click="BtnUpdate_Click" ToolTip="UPDATE – записва промените по избрания ред (Ctrl+S)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Запиши промените" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnDelete" Grid.Column="2" Style="{StaticResource BtnDanger}" Height="42"
                                            Click="BtnDelete_Click" ToolTip="DELETE – изтрива избрания ред (Del)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Изтрий" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnDuplicate" Style="{StaticResource BtnGhost}" Height="34"
                                            Click="BtnDuplicate_Click" ToolTip="Копира избрания продукт като нов (Ctrl+D)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Дублирай" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNew" Grid.Column="1" Style="{StaticResource BtnGhost}" Height="34"
                                            Click="BtnNew_Click" ToolTip="Изчиства формата за нов продукт (Ctrl+N)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C3;" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="Нов / изчисти" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= ЛЕНТА ЗА СЪСТОЯНИЕ ================= -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnDbPath" Style="{StaticResource StatusLinkBtn}" Click="BtnDbPath_Click"
                            ToolTip="Отвори папката с файла на базата данни">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="dbDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource SuccessBrush}" />
                            <TextBlock Text="SQLite: " />
                            <TextBlock x:Name="txtDbPath" Text="…" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="txtLastOperation" Grid.Column="1" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Ctrl+N нов  ·  Ctrl+S запис  ·  Del изтриване  ·  Ctrl+F търсене  ·  F5 обнови" />
                </Grid>
            </Border>

            <!-- Затъмняване при отворен диалог -->
            <Border x:Name="dimOverlay" Grid.RowSpan="3" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" />

            <!-- Известия (toast) в долния десен ъгъл -->
            <StackPanel x:Name="toastHost" Grid.RowSpan="3" Width="370"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,48" />
        </Grid>
    </Border>
</Window>
