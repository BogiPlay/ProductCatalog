<Window x:Class="ProductCatalog.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Потвърждение"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="20"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="iconBorder" Width="44" Height="44" CornerRadius="22"
                        VerticalAlignment="Top"
                        Background="{DynamicResource DangerSoftBrush}">
                    <TextBlock x:Name="iconText" Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="18"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DangerBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,0,0">
                    <TextBlock x:Name="txtTitle" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="txtMessage" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13.5"
                               LineHeight="20" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="btnCancel" Content="Отказ" Style="{StaticResource Btn}" MinWidth="100"
                        IsCancel="True" Click="BtnCancel_Click" />
                <Button x:Name="btnConfirm" Content="Потвърди" Style="{StaticResource BtnDangerSolid}" MinWidth="120"
                        Margin="10,0,0,0" IsDefault="True" Click="BtnConfirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
